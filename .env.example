# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/samaj?schema=public"
# Postgres pool size for this process. Total connections = POOL_MAX x instances.
# Keep (POOL_MAX x instances) below your Postgres max_connections.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
# Kills runaway queries so one bad query cannot hold a connection forever. 0 disables.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 chars in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN=30d
JWT_ISSUER=samajunati-api
JWT_AUDIENCE=samajunati-app

# ─── Infrastructure ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://localhost:5672"

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
# All five are REQUIRED in production.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. REQUIRED in production.
# Empty in development reflects the request origin back (convenient for LAN devices).
CORS_ORIGINS=http://localhost:3000

# ─── OTP ─────────────────────────────────────────────────────────────────────
# Echoes the generated OTP in the API response. Debugging aid for local work only;
# force-disabled when NODE_ENV=production regardless of this value.
OTP_DEBUG_RESPONSE=true
OTP_TTL_SECONDS=600
OTP_MAX_PER_WINDOW=3
OTP_RATE_WINDOW_SECONDS=900
# Keep at 4 unless the OTP input screens (web login/signup, mobile index) are
# updated — they render a fixed 4-box input.
OTP_CODE_DIGITS=4
# Wrong guesses allowed against one issued code before it is discarded.
OTP_MAX_VERIFY_ATTEMPTS=5

# ─── Authorization ───────────────────────────────────────────────────────────
# Comma-separated user IDs allowed to call maintenance endpoints
# (e.g. GET /api/relations/init-coords). Leave empty to disable those endpoints.
ADMIN_USER_IDS=

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Set to the number of proxies in front of the app (nginx=1, nginx+CDN=2).
# Must be correct or per-IP rate limiting can be bypassed via X-Forwarded-For.
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
BODY_LIMIT=256kb
# Requests slower than this are logged at warn level.
SLOW_REQUEST_MS=1000

# ─── Uploads ─────────────────────────────────────────────────────────────────
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_VIDEO_UPLOAD_BYTES=52428800
MAX_DOCUMENT_UPLOAD_BYTES=10485760
# Writes to ./uploads when R2 fails. Unbounded disk growth, so always off in production.
ALLOW_LOCAL_UPLOAD_FALLBACK=true

# ─── Caching ─────────────────────────────────────────────────────────────────
CACHE_TREE_TTL_SECONDS=1800
CACHE_CONFIG_TTL_SECONDS=3600
