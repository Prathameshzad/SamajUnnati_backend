# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/samaj?schema=public"
# Postgres pool size for this process. Total connections = POOL_MAX x instances.
# Keep (POOL_MAX x instances) below your Postgres max_connections.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
# Kills runaway queries so one bad query cannot hold a connection forever. 0 disables.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 chars in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN=30d
JWT_ISSUER=samajunati-api
JWT_AUDIENCE=samajunati-app

# ─── Infrastructure ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://localhost:5672"

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
# All five are REQUIRED in production.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. REQUIRED in production.
# Empty in development reflects the request origin back (convenient for LAN devices).
CORS_ORIGINS=http://localhost:3000

# ─── OTP ─────────────────────────────────────────────────────────────────────
# OTP values are never returned by HTTP. Configure SMS delivery below.
OTP_TTL_SECONDS=600
# Max OTP sends per phone per window. 5 sends per 15 minutes.
OTP_MAX_PER_WINDOW=5
OTP_RATE_WINDOW_SECONDS=900
# Keep at 4 unless the OTP input screens (web login/signup, mobile index) are
# updated — they render a fixed 4-box input.
OTP_CODE_DIGITS=4
# Wrong guesses allowed against one issued code before it is discarded.
OTP_MAX_VERIFY_ATTEMPTS=5

# ─── Authorization ───────────────────────────────────────────────────────────
# Comma-separated user IDs allowed to call maintenance endpoints
# (e.g. GET /api/relations/init-coords). Leave empty to disable those endpoints.
ADMIN_USER_IDS=

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Set to the number of proxies in front of the app (nginx=1, nginx+CDN=2).
# Must be correct or per-IP rate limiting can be bypassed via X-Forwarded-For.
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
BODY_LIMIT=256kb
# Requests slower than this are logged at warn level.
SLOW_REQUEST_MS=1000

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Size ceilings and the local-disk fallback are no longer configurable here.
# They are fixed in src/config/env.ts (UPLOAD_LIMITS / uploads.allowLocalFallback)
# so the accepted upload size is the same in every environment. The fallback is
# enabled automatically outside production.

# ─── Caching ─────────────────────────────────────────────────────────────────
CACHE_TREE_TTL_SECONDS=1800
CACHE_CONFIG_TTL_SECONDS=3600

# ─── Push notifications (Firebase Cloud Messaging, HTTP v1) ──────────────────
# Optional. When any of the three is missing, push is disabled and the app runs
# normally with in-app/socket notifications only — it is not a startup error.
#
# Where to get these:
#   Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> downloads a JSON file.
# Copy three fields out of that JSON. Do not commit the JSON itself.
#
#   project_id     -> FIREBASE_PROJECT_ID
#   client_email   -> FIREBASE_CLIENT_EMAIL
#   private_key    -> FIREBASE_PRIVATE_KEY
#
# FIREBASE_PRIVATE_KEY must be wrapped in double quotes and keep its literal \n
# escapes exactly as they appear in the JSON. Do not convert them to real line
# breaks. Example shape:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# This key can send push to every app in the Firebase project. Treat it like
# JWT_SECRET: server environment only, never in the mobile bundle or git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# How long FCM holds a notification for a device that is offline, in seconds.
# Default 2 days. 0 means "deliver now or drop".
PUSH_TTL_SECONDS=172800

# ─── OTP SMS gateway (BulkSMSIndia DLT) ──────────────────────────────────────
# OTPs are never returned by HTTP. Configure these values in every environment
# where users must be able to sign in; otherwise issuance cannot be delivered.
#
# REQUIRED in production:
#   SMS_AUTH_KEY   -> BulkSMSIndia account working/API key ("apikey")
#   SMS_SENDER_ID  -> DLT-approved 6-char sender id ("senderid")
#   SMS_PEID       -> DLT principal entity id ("peid")
#
# Pre-filled, override only if it changes:
#   SMS_BASE_URL    -> gateway base URL (default BulkSMSIndia)
#
# NOTE: DLT template ids are NOT configured here. They are static identifiers
# kept in code at src/constants/dltTemplates.ts, so new templates (email, other
# SMS) are added there without touching env.
SMS_AUTH_KEY=
SMS_SENDER_ID=
SMS_PEID=
SMS_BASE_URL=https://bulksmsindia.app
